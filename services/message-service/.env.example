SERVER_PORT=2906

SCYLLA_HOSTS=scylla:9042

S3_ENDPOINT=http://rustfs:9000
S3_REGION=us-east-1
S3_BUCKET=messages
S3_ACCESS_KEY=access
S3_SECRET_KEY=secret

NATS_URLS=nats://nats:4222
NATS_NAME=message-service
NATS_CONNECT_TIMEOUT=5s
NATS_RECONNECT_WAIT=2s
NATS_MAX_RECONNECTS=-1
NATS_DRAIN_TIMEOUT=10s
NATS_STREAM=MESSAGES
NATS_CONSUMER=message-send

LOG_LEVEL=INFO