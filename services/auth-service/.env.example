SERVER_PORT=2902

POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/auth?sslmode=disable
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_IDLE_CONNS=2
POSTGRES_MAX_CONN_LIFETIME=30m
POSTGRES_MAX_CONN_LIFETIME_JITTER=5m
POSTGRES_MAX_CONN_IDLE_TIME=5m
POSTGRES_HEALTH_CHECK_PERIOD=30s
POSTGRES_CONNECT_TIMEOUT=5s

TOKEN_PRIVATE_KEY_PATH=./keys/private.pem
TOKEN_ACCESS_TTL=15m
TOKEN_REFRESH_TTL=720h

KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=user.created

LOG_LEVEL=INFO